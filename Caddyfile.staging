{
    email official.megatronix@gmail.com
    admin off
    servers {
        trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    }
}

{$DOMAIN_HOST} {
    # -----------------------------
    # ENABLE COMPRESSION
    # -----------------------------
    encode gzip zstd

    # -----------------------------------
    # BLOCK INVALID HOST HEADERS
    # -----------------------------------
    @invalid_host not host {$DOMAIN_HOST}
    respond @invalid_host 403

    # -----------------------------
    # BLOCK HIDDEN FILES
    # -----------------------------
    @hidden path */.*
    respond @hidden 403

    # -----------------------------
    # SECURITY HEADERS
    # -----------------------------
    header {
        # Hide server info
        -Server

        # Prevent MIME sniffing
        X-Content-Type-Options "nosniff"

        # Clickjacking protection
        X-Frame-Options "DENY"

        # XSS protection
        X-XSS-Protection "1; mode=block"

        # Referrer control
        Referrer-Policy "strict-origin-when-cross-origin"

        # HTTPS enforcement
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # Disable powerful browser APIs
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }

    # -----------------------------
    # OPTIONAL: GRAFANA PROTECTION
    # -----------------------------
    @grafana path /grafana*
    handle @grafana {
        reverse_proxy paridhi-grafana:3000
    }

    # -----------------------------
    # SPRING BOOT API
    # -----------------------------
    handle {
        reverse_proxy app:{$SERVER_PORT:8080}
    }

    # -----------------------------
    # ACCESS LOGS
    # -----------------------------
    log {
        output file /var/log/caddy/api-access.log
        format json
    }
}